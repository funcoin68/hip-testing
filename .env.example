# Lighter TESTNET only — fake money. Never put a mainnet key or URL here.
WALLET_PRIVATE_KEY=0xREPLACE_WITH_YOUR_TESTNET_PRIVATE_KEY
# Lighter TESTNET API endpoint only; mainnet hosts are refused by client.py validation.
LIGHTER_API_URL=https://testnet.zklighter.io
# API key generated by `python -m lighter_testing.api_keys` — the script prints
# the key to stdout only and never writes it to disk (placeholder, not a real key).
LIGHTER_API_KEY=
LIGHTER_PUBLIC_KEY=
LIGHTER_PRIVATE_KEY=
# Kalshi DEMO environment only — fake money. Never commit a real key here.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY=
KALSHI_WS_URL=
# Kalshi DEMO REST endpoint only (fake money) — used to list an event's markets.
KALSHI_REST_URL=
